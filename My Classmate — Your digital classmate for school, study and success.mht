@charset "utf-8";

@keyframes spin { 
  100% { transform: rotate(360deg); }
}

@keyframes scale { 
  0%, 100% { transform: none; }
  50% { transform: scale3d(1, 1, 1); }
}

@keyframes stroke { 
  100% { stroke-dashoffset: 0; }
}

@keyframes scale-up-center { 
  0% { transform: scale(0.01); }
  100% { transform: scale(1); }
}

@keyframes success-badge-orbit-in { 
  0% { transform: rotate(-12deg) scale(0.6); opacity: 0; }
  70% { transform: rotate(2deg) scale(1.06); opacity: 1; }
  100% { transform: rotate(0deg) scale(1); opacity: 1; }
}

@keyframes success-orbit-resolve { 
  0% { transform: rotate(-80deg) scale(0.6); opacity: 0; }
  20% { opacity: 1; }
  75% { opacity: 0.8; }
  100% { transform: rotate(280deg) scale(0.5); opacity: 0; }
}

@keyframes failure-orbit-break { 
  0% { transform: rotate(-60deg) scale(0.7); opacity: 0; }
  22% { opacity: 1; }
  68% { transform: rotate(190deg) scale(1); opacity: 0.8; }
  100% { transform: rotate(225deg) scale(0.48); opacity: 0; }
}

@keyframes failure-badge-settle { 
  0% { transform: scale(0.68); opacity: 0; }
  72% { transform: scale(1.04); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes failure-mark-rise { 
  0% { transform: translateY(2px); opacity: 0; }
  100% { transform: translateY(0px); opacity: 1; }
}

@keyframes unspin { 
  40% { stroke-width: 1px; stroke-linecap: square; stroke-dashoffset: 192; }
  100% { stroke-width: 0; }
}

#PAdD9 { width: 30px; height: 30px; display: flex; border-radius: 50%; box-shadow: rgb(34, 139, 73) 0px 0px 0px inset; fill: rgb(255, 255, 255); stroke: rgb(255, 255, 255); stroke-miterlimit: 10; grid-area: 1 / 1; transform-origin: center center; animation: 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) 0.26s 1 normal both running success-badge-orbit-in; stroke-width: 6px; }

#PAdD9 .mGPdy9 { animation: 0.28s cubic-bezier(0.65, 0, 0.45, 1) 0.41s 1 normal forwards running stroke; box-shadow: rgb(34, 139, 73) 0px 0px 0px inset; stroke-dasharray: 242; stroke-dashoffset: 242; }

.WRFD6 { stroke-dashoffset: 0; stroke-width: 2; stroke-miterlimit: 10; stroke: rgb(34, 139, 73); fill: rgb(34, 139, 73); }

#ZvYSd8 { width: 30px; height: 30px; grid-area: 1 / 1; overflow: visible; }

#ZvYSd8 g { transform-box: fill-box; transform-origin: center center; animation: 0.62s cubic-bezier(0.2, 0.7, 0.2, 1) 0s 1 normal both running success-orbit-resolve; }

.agcy9 { opacity: 0.3; fill: none; stroke: rgb(34, 139, 73); stroke-width: 1; }

.TEnz3 { fill: rgb(34, 139, 73); }

.TsxKS6 { stroke-width: 3px; stroke-linecap: round; stroke: rgb(34, 139, 73); stroke-dasharray: 0, 100, 0; stroke-dashoffset: 200; stroke-miterlimit: 1; stroke-linejoin: round; }

#ILoo3, #yuOn2 { width: 30px; height: 30px; display: flex; border-radius: 50%; box-shadow: rgb(178, 15, 3) 0px 0px 0px inset; stroke-width: 1px; fill: rgb(255, 255, 255); stroke: rgb(255, 255, 255); stroke-miterlimit: 10; }

.clJIB6 { stroke-width: 2; stroke: rgb(178, 15, 3); fill: rgb(178, 15, 3); }

.skJqd1 { fill: rgb(242, 242, 242); }

.PiqSk7 { opacity: 0.28; fill: none; stroke: rgb(178, 15, 3); stroke-width: 1; }

.ewPUs7 { fill: rgb(178, 15, 3); }

#ILoo3 .ZSEqc7, #ILoo3 .LLWD8 { transform-box: view-box; transform-origin: center center; }

#ILoo3 .ZSEqc7 { animation: 0.52s cubic-bezier(0.2, 0.7, 0.2, 1) 0s 1 normal both running failure-orbit-break; }

#ILoo3 .LLWD8 { animation: 0.34s cubic-bezier(0.22, 1, 0.36, 1) 0.19s 1 normal both running failure-badge-settle; }

#ILoo3 .skJqd1 { transform-box: fill-box; transform-origin: center center; animation: 0.22s ease-out 0.31s 1 normal both running failure-mark-rise; }

#yuOn2 { width: 12px; height: 12px; }

#yuOn2 .ZSEqc7 { display: none; }

#xtFU2, #yrzeX6 { display: flex; animation: 5s linear 0s infinite normal none running spin; width: 30px; height: 30px; }

.RmKd5, .Uyfl4 { stroke-dasharray: 166; stroke-dashoffset: 166; stroke-width: 2; stroke-miterlimit: 10; stroke: rgb(89, 89, 89); fill: rgb(89, 89, 89); }

#NOAZi9, #oVSO6 { width: 30px; height: 30px; display: flex; border-radius: 50%; box-shadow: rgb(89, 89, 89) 0px 0px 0px inset; stroke-width: 1px; fill: rgb(255, 255, 255); stroke: rgb(255, 255, 255); stroke-miterlimit: 10; animation: 0.3s ease-in-out 0.9s 1 normal both running scale; }

#BJfo9 { display: inline-flex; flex-direction: column; text-align: right; }

#AiQGD8 { margin-bottom: 1px; height: 25px; }

.RoXCP2 { fill: rgb(0, 0, 0); }

.IQLJP3 .TsxKS6 { animation: 0.7s cubic-bezier(0.65, 0, 0.45, 1) 0s 1 normal forwards running unspin; }

@media (prefers-reduced-motion: reduce) {
  #ZvYSd8 { opacity: 0; }
  #ZvYSd8 g { animation-duration: 0.001ms; }
  #PAdD9, #PAdD9 .mGPdy9 { animation: auto ease 0s 1 normal none running none; }
  #PAdD9 .mGPdy9 { stroke-dashoffset: 0; }
  #ILoo3 .ZSEqc7 { display: none; }
  #ILoo3 .LLWD8, #ILoo3 .skJqd1 { animation: auto ease 0s 1 normal none running none; }
}

